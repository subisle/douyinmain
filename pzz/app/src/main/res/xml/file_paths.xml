<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外部存储的Pictures目录 -->
    <external-path
        name="external_pictures"
        path="Pictures/" />
    
    <!-- 外部存储的Downloads目录 -->
    <external-path
        name="external_downloads"
        path="Download/" />
    
    <!-- 应用私有缓存目录 -->
    <cache-path
        name="cache"
        path="/" />
    
    <!-- 应用私有文件目录 -->
    <files-path
        name="files"
        path="/" />
</paths>
